// 02-val-vs-expr.dax
// Demo 2: the same function written twice. Only the passing mode of "metric" changes.
//
// VAL (the default) evaluates the argument once, before the function runs.
// The function receives a number, so CALCULATE inside it cannot change it.
// EXPR passes the expression itself. The function evaluates it where it is used,
// so CALCULATE ( metric, REMOVEFILTERS ( scope ) ) really removes the filter.
//
// Expected: the VAL column shows 100% on every row. The EXPR column shows real shares
// that add up to 100%.

DEFINE
    /// Wrong on purpose: metric arrives already evaluated.
    FUNCTION AW.ShareOfVal = (
            metric : SCALAR VAL,
            scope : COLUMNREF
        ) =>
        DIVIDE ( metric, CALCULATE ( metric, REMOVEFILTERS ( scope ) ) )

    /// Share of the current value in the total over all values of one column.
    /// @param {SCALAR EXPR} metric - The value to compare, evaluated inside the function.
    /// @param {COLUMNREF} scope - The column whose filter is removed for the total.
    /// @returns A ratio between 0 and 1, or BLANK when the total is blank or zero.
    FUNCTION AW.ShareOf = (
            metric : SCALAR EXPR,
            scope : COLUMNREF
        ) =>
        DIVIDE ( metric, CALCULATE ( metric, REMOVEFILTERS ( scope ) ) )

EVALUATE
SUMMARIZECOLUMNS (
    'Product'[Category],
    "Sales", SUM ( Sales[Sales Amount] ),
    "Share VAL", AW.ShareOfVal ( SUM ( Sales[Sales Amount] ), 'Product'[Category] ),
    "Share EXPR", AW.ShareOf ( SUM ( Sales[Sales Amount] ), 'Product'[Category] )
)
ORDER BY 'Product'[Category]

// Evidence: the EXPR shares must add up to 1.
// CALCULATE turns each SUMX row into a filter on the category. Without it, SUM sees
// no category filter, every share is 1, and the sum is the number of categories.
EVALUATE
{
    SUMX (
        VALUES ( 'Product'[Category] ),
        CALCULATE ( AW.ShareOf ( SUM ( Sales[Sales Amount] ), 'Product'[Category] ) )
    )
}
