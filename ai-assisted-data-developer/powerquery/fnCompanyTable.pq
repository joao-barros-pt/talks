// fnCompanyTable
// One Business Central API v2.0 entity from one company, with a "company" column.
// The same function serves every company and every entity: one query, N companies.
//
// How to add it:
//   Power BI Desktop: Transform data, New source, Blank query, Advanced editor, paste, rename the query to fnCompanyTable.
//   Dataflow Gen2:    Get data, Blank query, paste, rename to fnCompanyTable. Sign in with your organizational account
//                     (Microsoft Entra ID) the first time the connector asks.
//
// Example call:
//   fnCompanyTable("LAB-SESSOES", "CRONUS Lisboa", "customers")
//
// The connector is "Dynamics 365 Business Central" (data source kind Dynamics365BusinessCentral).
// The navigation below (environment, company, "v2.0", entity) is what the Navigator writes when you pick
// Standard APIs v2.0 (the autogenerated query in Microsoft Learn, see SOURCES.md). Before the first run,
// compare it once with the code the Navigator generates in your own lab: open one entity through Get data
// and look at the Advanced editor.

(environment as text, company as text, entity as text) as table =>
let
    // 1. Connect. All parameters null: the Navigator lists every environment you can see.
    //    UseReadOnlyReplica = true is the default and keeps the reads off the primary database.
    Source = Dynamics365BusinessCentral.ApiContentsWithOptions(null, null, null, [UseReadOnlyReplica = true]),

    // 2. The environment, by name as the Navigator shows it (for the lab: "LAB-SESSOES").
    EnvironmentNode = Source{[Name = environment]}[Data],

    // 3. The company, by name (for example "CRONUS Lisboa").
    CompanyNode = EnvironmentNode{[Name = company]}[Data],

    // 4. The Standard APIs v2.0 folder. In M the node is named "v2.0".
    StandardApis = CompanyNode{[Name = "v2.0"]}[Data],

    // 5. The entity: "customers", "items", "salesInvoices" or "generalLedgerEntries".
    EntityTable = StandardApis{[Name = entity, Signature = "table"]}[Data],

    // 6. Keep scalar columns only. API entities carry navigation columns (for example the invoice lines
    //    or the customer record) that a lakehouse table can't store.
    NestedColumns = Table.SelectRows(Table.Schema(EntityTable), each List.Contains({"table", "record", "list"}, [Kind]))[Name],
    Flat = Table.RemoveColumns(EntityTable, NestedColumns, MissingField.Ignore),

    // 7. Lakehouse tables don't take DateTimeZone. Turn those columns (lastModifiedDateTime, for example)
    //    into plain datetime in UTC.
    ZonedColumns = Table.SelectRows(Table.Schema(Flat), each [Kind] = "datetimezone")[Name],
    NoTimeZone = Table.TransformColumns(
        Flat,
        List.Transform(
            ZonedColumns,
            (column) => {column, (value) => if value = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(value)), type nullable datetime}
        )
    ),

    // 8. API enums (status, documentType, blocked...) come untyped. A lakehouse destination drops untyped
    //    columns, so they become text.
    AnyColumns = Table.SelectRows(Table.Schema(NoTimeZone), each [Kind] = "any")[Name],
    Typed = Table.TransformColumnTypes(NoTimeZone, List.Transform(AnyColumns, (column) => {column, type nullable text})),

    // 9. The company goes into every row. Numbers repeat across companies, so this column is part of every key.
    WithCompany = Table.AddColumn(Typed, "company", each company, type text),

    // 10. Company first, then the API columns in their original order.
    Result = Table.ReorderColumns(WithCompany, {"company"} & Table.ColumnNames(Typed))
in
    Result
